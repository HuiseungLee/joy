# JOY MAP 로그인 (비밀번호는 12자 이상)
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-long-unique-password

# 세션 서명용 32자 이상 임의 문자열: openssl rand -hex 32
SECRET_KEY=replace-with-at-least-32-random-characters
SESSION_HOURS=168
COOKIE_SECURE=true

# Google Cloud Console에서 발급
GOOGLE_MAPS_API_KEY=replace-with-your-browser-api-key
GOOGLE_MAP_ID=DEMO_MAP_ID

# Synology 내부 수신 포트 (문법 사이트 7320과 분리)
JOY_MAP_PORT=7330
